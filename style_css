* {
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui,
    sans-serif;
}

body {
  margin: 0;
  background: radial-gradient(circle at top left, #f0f3ff 0, #f9fafc 40%, #f5f7fd 100%);
  color: #222;
}

.page {
  max-width: 1120px;
  margin: 32px auto;
  padding: 0 16px 40px;
}

.header {
  text-align: center;
  margin-bottom: 24px;
}

.header h1 {
  margin: 0 0 8px;
  font-size: 2rem;
}

.header p {
  margin: 0;
  color: #555;
  font-size: 0.95rem;
}

.main {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr);
  gap: 20px;
}

@media (max-width: 900px) {
  .main {
    grid-template-columns: 1fr;
  }
}

.card {
  background: #ffffff;
  border-radius: 20px;
  padding: 22px 20px 24px;
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
}

.card h2 {
  margin: 0 0 8px;
  font-size: 1.15rem;
}

.hint {
  margin: 0 0 14px;
  font-size: 0.9rem;
  color: #666;
}

textarea {
  width: 100%;
  min-height: 170px;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid #d6d9e6;
  resize: vertical;
  font-size: 0.95rem;
  line-height: 1.5;
}

textarea:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18);
}

button {
  margin-top: 14px;
  padding: 10px 18px;
  border-radius: 999px;
  border: none;
  font-size: 0.96rem;
  font-weight: 600;
  cursor: pointer;
  background: linear-gradient(135deg, #6366f1, #ec4899);
  color: #fff;
}

button:hover {
  opacity: 0.94;
}

.card-result {
  position: relative;
}

.empty-state {
  text-align: center;
  padding: 50px 10px;
  color: #7a7e8c;
  font-size: 0.95rem;
}

.result.hidden {
  display: none;
}

.result {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.top-row {
  display: flex;
  gap: 18px;
}

@media (max-width: 750px) {
  .top-row {
    flex-direction: column;
  }
}

.thermo-wrapper {
  width: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thermo {
  position: relative;
  width: 36px;
  height: 140px;
  border-radius: 999px;
  background: #e5e7f5;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6px;
}

.thermo-inner {
  width: 16px;
  height: 100px;
  border-radius: 999px;
  background: #d4d8f5;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.thermo-fill {
  width: 100%;
  height: 0%;
  transition: height 0.4s ease;
}

/* 온도에 따라 JS에서 클래스 변경 (low/mid/high) */
.thermo-fill.low {
  background: #3b82f6;
}
.thermo-fill.mid {
  background: #facc15;
}
.thermo-fill.high {
  background: #f97373;
}

.thermo-bulb {
  position: absolute;
  bottom: -12px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #e5e7f5;
  z-index: -1;
}

.thermo-temp {
  margin-top: 10px;
  font-size: 1.6rem;
  font-weight: 700;
}

.thermo-label {
  margin: 4px 0 0;
  font-size: 0.85rem;
  color: #666;
  text-align: center;
}

.summary {
  flex: 1;
  padding: 10px 12px;
  border-radius: 16px;
  background: #f4f4ff;
}

.summary h3 {
  margin: 0 0 6px;
  font-size: 0.95rem;
}

.summary p {
  margin: 0;
  font-size: 0.93rem;
  line-height: 1.6;
  color: #333;
}

.detail h3 {
  margin: 0 0 6px;
  font-size: 0.96rem;
}

.detail p {
  margin: 0;
  font-size: 0.93rem;
  line-height: 1.7;
  color: #333;
}

.footer {
  margin-top: 20px;
  text-align: center;
  font-size: 0.85rem;
  color: #777;
}
